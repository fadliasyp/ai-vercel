        },
        {
          "question": "barangnya caccat dan tidak sesuai deskripsi, bisa refund ga?",
          "expect": {
            "scope": "in_scope",
            "customer_state": "distressed",
            "signals": { "return_policy": true }
          }
        }
      ]
