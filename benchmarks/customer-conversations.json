    {
      "id": "secure-shipping",
      "scenario": "Pengiriman produk premium",
      "turns": [
        {
          "question": "Ongkir ke Surabaya untuk Getter Robo GX-74 berapa? Pengirimannya aman kan, bisa asuransi dan packing kayu?",
          "expect": {
            "scope": "in_scope",
            "explicit_intent": "shipping_transaction",
            "customer_state": "worried",
            "entities": { "shipping_destination": "Surabaya" },
            "signals": {
              "shipping_quote": true,
              "insurance": true,
              "packing_protection": true,
              "transaction_policy": true
            },
            "policy_includes": ["Asuransi Pengiriman", "Packing kayu"]
          },
          "context_after": {
            "lastIntent": "shipping_transaction",
            "pendingType": "shipping_quote"
          }
        },
        {
          "question": "Surabaya, Wonokromo",
          "expect": {
            "signals": { "shipping_quote_followup": true },
            "entities": {
              "followup_city": "Surabaya",
              "followup_district": "Wonokromo"
            }
          }
        }
      ]
    },
    {
      "id": "order-status",
      "scenario": "Pembeli tidak sabar menunggu pesanan",
      "turns": [
        {
          "question": "Cek status pesanan Order #5007 dong, kok dari kemarin belum dikirim?",
          "expect": {
            "scope": "in_scope",
            "explicit_intent": "transaction_status",
            "customer_state": "worried",
            "entities": { "order_id": "5007" },
            "signals": { "transaction_status": true },
            "policy_includes": ["email atau nomor telepon tagihan"]
          },
          "context_after": {
            "lastIntent": "transaction_status",
            "pendingType": "transaction_status"
          }
        },
        {
          "question": "email tagihan saya pelanggan@example.invalid",
          "expect": {
            "signals": { "order_verification": true }
          }
        }
      ]
    },
    {
      "id": "store-visit",
      "scenario": "Pemeriksaan produk di toko fisik",
