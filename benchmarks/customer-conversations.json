    {
      "id": "return-damaged",
      "scenario": "Pembeli panik mengajukan retur",
      "turns": [
        {
          "question": "Pesanan Getter Robo baru sampai, tapi cat dadanya terkelupas padahal dibilang mint. Bisa retur dan uang saya kembali?",
