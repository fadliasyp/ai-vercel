        {
          "question": "Halo, part tangan kanan Mazinger Z ini masuk JUNK ya? Ada patah di engsel atau cuma lecet cat?",
          "expect": {
            "scope": "in_scope",
            "customer_state": "distressed",
            "entities": { "conditions": ["JUNK"] }
          }
        },
        {
          "question": "barang junk ini engselnya pataah atau hanya lecet?",
          "expect": {
            "scope": "in_scope",
            "customer_state": "distressed",
            "entities": { "conditions": ["JUNK"] }
          }
        }
      ]
    },
